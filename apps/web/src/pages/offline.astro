---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout title={`当前处于离线状态｜${site.name}`} description={`网络恢复后可继续浏览${site.name}。`} noindex>
  <section class="offline-card lm-card lm-container lm-reading">
    <p class="eyebrow">离线状态</p>
    <h1>网络暂时不可用。</h1>
    <p>已经缓存的页面和工具资源仍可继续使用。首次访问的内容需要等网络恢复后加载。</p>
    <a class="lm-button lm-button--primary" href="/">返回首页</a>
  </section>
</BaseLayout>
