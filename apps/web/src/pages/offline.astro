---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatePanel from "../components/StatePanel.astro";
import { site } from "../config/site";
---

<BaseLayout title={`当前处于离线状态｜${site.name}`} description={`网络恢复后可继续浏览${site.name}。`} noindex>
  <div class="lm-page lm-container">
    <section class="lm-state-page">
      <StatePanel
        variant="offline"
        eyebrow="离线状态"
        title="网络暂时不可用。"
        description="已经缓存的页面和工具资源仍可继续使用。首次访问的内容需要等网络恢复后加载。"
        primary={{ href: "/", label: "返回首页" }}
        secondary={{ href: "/tools/", label: "查看已缓存工具" }}
      />
    </section>
  </div>
</BaseLayout>
