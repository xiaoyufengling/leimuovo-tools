---
import { ArrowLeft, Box, Braces, Cable, Layers, Terminal, Zap } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="EV63 Device Presence｜小鱼干实验室"
  description="用真实 WebHID 设备状态驱动 IQUNIX EV63 程序化 3D 结构实验。"
  noindex
  hideChrome
>
  <div class="ev63-lab" data-ev63-lab data-device-state="waiting" data-phase="waiting">
    <div class="ev63-backdrop" aria-hidden="true">
      <span class="ev63-grid"></span>
      <span class="ev63-aura ev63-aura--violet"></span>
      <span class="ev63-aura ev63-aura--cyan"></span>
      <span class="ev63-grain"></span>
      <span class="ev63-vignette"></span>
    </div>

    <header class="ev63-nav">
      <a class="ev63-nav__brand" href="/xiaoyugan/" aria-label="返回小鱼干视觉实验室">
        <span class="ev63-nav__mark" aria-hidden="true"><Zap size={15} stroke-width={1.8} /></span>
        <span>小鱼干实验室</span>
        <small>LAB 002</small>
      </a>
      <div class="ev63-nav__actions">
        <button class="ev63-nav__control" type="button" data-log-toggle aria-expanded="false" aria-controls="ev63-hid-log">
          <Terminal size={15} stroke-width={1.7} aria-hidden="true" />
          <span>HID LOG</span>
        </button>
        <a class="ev63-nav__back" href="/xiaoyugan/">
          <ArrowLeft size={15} stroke-width={1.8} aria-hidden="true" />
          <span>返回实验室</span>
        </a>
      </div>
    </header>

    <main class="ev63-stage">
      <canvas
        class="ev63-canvas"
        data-ev63-canvas
        role="img"
        aria-label="IQUNIX EV63 键盘内部结构的交互式三维模型"
      ></canvas>

      <div class="ev63-webgl-fallback" data-webgl-fallback hidden>
        <Box size={24} aria-hidden="true" />
        <strong>3D 场景无法启动</strong>
        <p>当前设备没有提供可用的 WebGL 环境。HID 探测功能仍可在日志中使用。</p>
      </div>

      <section class="ev63-title" aria-labelledby="ev63-title">
        <p>EXPERIMENT / 002</p>
        <h1 id="ev63-title"><span>IQUNIX</span> EV63</h1>
        <div class="ev63-title__rule"><i></i><span>DEVICE PRESENCE → SPATIAL RESPONSE</span></div>
      </section>

      <section class="ev63-device-card" aria-live="polite" aria-atomic="true">
        <div class="ev63-device-card__status">
          <span class="ev63-device-card__signal" aria-hidden="true"></span>
          <p data-device-eyebrow>DEVICE / SCANNING</p>
        </div>
        <h2 data-device-title>正在检查设备</h2>
        <p data-device-detail>正在查询已授权的 HID 设备。</p>
        <div class="ev63-device-card__actions">
          <button class="ev63-button ev63-button--primary" type="button" data-connect-device>CONNECT EV63</button>
          <button class="ev63-button" type="button" data-run-demo>RUN DEMO</button>
        </div>
        <p class="ev63-device-card__notice"><Cable size={13} aria-hidden="true" /> 演示模式与实体连接始终明确区分</p>
      </section>

      <div class="ev63-phase" aria-live="polite">
        <span></span>
        <p data-phase-label>WAITING FOR DEVICE</p>
        <span></span>
      </div>

      <section class="ev63-view-controls" aria-label="三维结构视图">
        <p>STRUCTURE VIEW</p>
        <div>
          <button type="button" data-view-assembled aria-pressed="true">
            <Box size={15} aria-hidden="true" /> 整机
          </button>
          <button type="button" data-view-exploded aria-pressed="false">
            <Layers size={15} aria-hidden="true" /> 拆解
          </button>
        </div>
        <small>拖动模型旋转视角</small>
      </section>

      <aside class="ev63-layer-index" aria-label="EV63 内部结构">
        <p>VERIFIED ASSEMBLY</p>
        <ol>
          <li><span>01</span><strong>PBT KEYCAPS</strong></li>
          <li><span>02</span><strong>MAGNETIC X PRO</strong></li>
          <li><span>03</span><strong>ALUMINUM PLATE</strong></li>
          <li><span>04</span><strong>PORON / PET</strong></li>
          <li><span>05</span><strong>HALL SENSOR PCB</strong></li>
          <li><span>06</span><strong>ALUMINUM CASE</strong></li>
        </ol>
      </aside>

      <aside class="ev63-spec-strip" aria-label="已核验规格">
        <div><span>LAYOUT</span><strong>64 KEY / ANSI</strong></div>
        <div><span>MOUNT</span><strong>TRAY</strong></div>
        <div><span>REPORT</span><strong>8,000 HZ</strong></div>
        <div><span>SENSOR</span><strong>HALL / GEN 3</strong></div>
      </aside>

      <p class="ev63-evidence">
        PROCEDURAL MODEL · VERIFIED AGAINST
        <a href="https://iqunix.com/products/iqunix-ev63-hall-effect-keyboard" target="_blank" rel="noreferrer">IQUNIX</a>
        +
        <a href="https://kbd.news/IQUNIX-EV63-HE-review-2843.html" target="_blank" rel="noreferrer">TEARDOWN</a>
      </p>
    </main>

    <aside class="ev63-log" id="ev63-hid-log" data-log-panel hidden aria-label="EV63 HID 调试日志">
      <header>
        <div>
          <p>HARDWARE PROBE</p>
          <h2>EV63 HID LOG</h2>
        </div>
        <button type="button" data-log-close aria-label="关闭 HID 日志">×</button>
      </header>
      <dl class="ev63-log__identity">
        <div><dt>Vendor ID</dt><dd data-vendor-id>0x3869</dd></div>
        <div><dt>Product ID</dt><dd data-product-id>0x63E1</dd></div>
        <div><dt>Interface</dt><dd data-interface>VENDOR HID / EXPECTED</dd></div>
      </dl>
      <div class="ev63-log__collections">
        <p><Braces size={13} aria-hidden="true" /> COLLECTIONS / REPORT MAP</p>
        <pre data-collections>等待实机授权后读取 collections</pre>
      </div>
      <ol class="ev63-log__entries" data-log-list></ol>
      <footer>
        <span>READ-ONLY PROBE</span>
        <span>NO OUTPUT REPORTS SENT</span>
      </footer>
    </aside>
  </div>

  <script>
    import { mountEv63Lab } from "../../lib/ev63/lab";

    const root = document.querySelector<HTMLElement>("[data-ev63-lab]");
    if (root) {
      const dispose = mountEv63Lab(root);
      window.addEventListener("pagehide", (event) => {
        if (!event.persisted) dispose();
      });
    }
  </script>
</BaseLayout>

<style>
  :global(html) {
    background: #050507;
    color-scheme: dark;
  }

  :global(body) {
    min-width: 320px;
    overflow: hidden;
    background: #050507;
  }

  .ev63-lab {
    --ev63-violet: #a68bff;
    --ev63-cyan: #70e7ff;
    --ev63-line: rgba(255, 255, 255, 0.12);
    --ev63-muted: rgba(244, 243, 249, 0.48);
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 68% 38%, rgba(109, 72, 214, 0.11), transparent 31rem),
      linear-gradient(155deg, #09090d 0%, #050507 46%, #09080d 100%);
    color: #f5f4f8;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
    isolation: isolate;
  }

  .ev63-backdrop,
  .ev63-grid,
  .ev63-grain,
  .ev63-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ev63-backdrop {
    z-index: -1;
    overflow: hidden;
  }

  .ev63-grid {
    background-image:
      linear-gradient(rgba(255,255,255,.042) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.042) 1px, transparent 1px);
    background-size: clamp(3rem, 5vw, 5rem) clamp(3rem, 5vw, 5rem);
    mask-image: radial-gradient(circle at 63% 54%, black, transparent 67%);
    opacity: 0.75;
  }

  .ev63-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitchTiles'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.58'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
    opacity: 0.045;
  }

  .ev63-vignette {
    background: radial-gradient(ellipse at 58% 50%, transparent 35%, rgba(0,0,0,.68) 100%);
  }

  .ev63-aura {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(6rem);
    opacity: 0.22;
    transition: opacity 900ms ease, transform 1.4s cubic-bezier(.2,.8,.2,1);
  }

  .ev63-aura--violet {
    width: 42rem;
    height: 42rem;
    top: 4%;
    right: 11%;
    background: #643dff;
  }

  .ev63-aura--cyan {
    width: 24rem;
    height: 24rem;
    right: -5rem;
    bottom: -8rem;
    background: #00bcff;
    opacity: 0.1;
  }

  .ev63-lab[data-device-state="connected"] .ev63-aura,
  .ev63-lab[data-device-state="demo"] .ev63-aura {
    opacity: 0.34;
    transform: scale(1.12);
  }

  .ev63-nav {
    position: fixed;
    z-index: 50;
    top: max(1rem, env(safe-area-inset-top));
    left: 50%;
    display: flex;
    width: min(calc(100% - 2rem), 78rem);
    min-height: 3.55rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 1.1rem;
    padding: .5rem .55rem .5rem 1rem;
    background: rgba(9, 9, 13, 0.62);
    box-shadow: inset 0 1px rgba(255,255,255,.09), 0 1.3rem 4rem rgba(0,0,0,.26);
    backdrop-filter: blur(1.4rem) saturate(145%);
    transform: translateX(-50%);
  }

  .ev63-nav__brand,
  .ev63-nav__actions,
  .ev63-nav__control,
  .ev63-nav__back {
    display: inline-flex;
    align-items: center;
  }

  .ev63-nav__brand,
  .ev63-nav__back {
    color: inherit;
    text-decoration: none;
  }

  .ev63-nav__brand {
    min-height: 2.5rem;
    gap: .6rem;
    font-size: .8rem;
    font-weight: 680;
  }

  .ev63-nav__mark {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid rgba(187,170,255,.26);
    border-radius: .65rem;
    background: rgba(135,95,255,.13);
    color: #cfc3ff;
    box-shadow: inset 0 1px rgba(255,255,255,.12), 0 0 1.6rem rgba(129,88,255,.2);
  }

  .ev63-nav__brand small {
    border-left: 1px solid rgba(255,255,255,.16);
    padding-left: .6rem;
    color: rgba(255,255,255,.38);
    font-size: .58rem;
    letter-spacing: .14em;
  }

  .ev63-nav__actions { gap: .35rem; }

  .ev63-nav__control,
  .ev63-nav__back {
    min-height: 2.5rem;
    gap: .42rem;
    border: 0;
    border-radius: .8rem;
    padding: 0 .82rem;
    background: rgba(255,255,255,.065);
    color: rgba(255,255,255,.7);
    font: 620 .67rem/1 inherit;
    letter-spacing: .04em;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, transform 100ms ease;
  }

  .ev63-nav__control:hover,
  .ev63-nav__back:hover { background: rgba(255,255,255,.12); color: white; }
  .ev63-nav__control:active,
  .ev63-nav__back:active { transform: scale(.97); }

  .ev63-stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .ev63-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    outline: none;
    touch-action: none;
  }

  .ev63-canvas[data-dragging] { cursor: grabbing; }

  .ev63-title {
    position: absolute;
    z-index: 4;
    top: clamp(7.5rem, 14vh, 10rem);
    left: max(1.25rem, calc((100vw - 78rem) / 2));
    max-width: 38rem;
    pointer-events: none;
  }

  .ev63-title > p,
  .ev63-view-controls > p,
  .ev63-layer-index > p,
  .ev63-log header p {
    margin: 0;
    color: rgba(224,218,245,.43);
    font-size: .59rem;
    font-weight: 680;
    letter-spacing: .18em;
  }

  .ev63-title h1 {
    margin: .7rem 0 0;
    font-size: clamp(3.8rem, 9vw, 8.1rem);
    font-weight: 650;
    line-height: .83;
    letter-spacing: -.07em;
    text-shadow: 0 1rem 4rem rgba(0,0,0,.38);
  }

  .ev63-title h1 span {
    display: block;
    color: rgba(255,255,255,.25);
    font-size: .34em;
    font-weight: 560;
    letter-spacing: .02em;
  }

  .ev63-title__rule {
    display: flex;
    margin-top: 1.3rem;
    align-items: center;
    gap: .8rem;
    color: rgba(255,255,255,.34);
    font-size: .54rem;
    font-weight: 620;
    letter-spacing: .12em;
  }

  .ev63-title__rule i { width: 2.6rem; height: 1px; background: linear-gradient(90deg, #a98cff, transparent); }

  .ev63-device-card {
    position: absolute;
    z-index: 6;
    bottom: max(2.15rem, env(safe-area-inset-bottom));
    left: max(1.25rem, calc((100vw - 78rem) / 2));
    width: min(25rem, calc(100% - 2.5rem));
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 1.25rem;
    padding: 1.15rem;
    background: linear-gradient(135deg, rgba(255,255,255,.095), rgba(255,255,255,.025)), rgba(8,8,12,.68);
    box-shadow: inset 0 1px rgba(255,255,255,.1), 0 1.5rem 5rem rgba(0,0,0,.34);
    backdrop-filter: blur(1.6rem) saturate(140%);
  }

  .ev63-device-card__status {
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  .ev63-device-card__status p {
    margin: 0;
    color: rgba(255,255,255,.43);
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .ev63-device-card__signal {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    background: #8f889f;
    box-shadow: 0 0 0 .22rem rgba(143,136,159,.1);
    transition: background 300ms ease, box-shadow 300ms ease;
  }

  [data-device-state="connected"] .ev63-device-card__signal {
    background: #84f2bd;
    box-shadow: 0 0 0 .22rem rgba(132,242,189,.11), 0 0 1.4rem rgba(132,242,189,.62);
  }

  [data-device-state="demo"] .ev63-device-card__signal {
    background: #b39bff;
    box-shadow: 0 0 0 .22rem rgba(179,155,255,.12), 0 0 1.4rem rgba(179,155,255,.62);
  }

  [data-device-state="connecting"] .ev63-device-card__signal { animation: ev63-signal 1s ease-in-out infinite; }

  .ev63-device-card h2 {
    margin: .65rem 0 0;
    font-size: 1.5rem;
    font-weight: 630;
    letter-spacing: -.035em;
  }

  .ev63-device-card > p:not(.ev63-device-card__notice) {
    min-height: 2.8em;
    margin: .5rem 0 0;
    color: rgba(255,255,255,.48);
    font-size: .78rem;
    line-height: 1.55;
  }

  .ev63-device-card__actions {
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    gap: .5rem;
    margin-top: 1rem;
  }

  .ev63-button {
    min-height: 2.65rem;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: .85rem;
    background: rgba(255,255,255,.06);
    color: rgba(255,255,255,.72);
    font: 700 .63rem/1 inherit;
    letter-spacing: .08em;
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 100ms ease;
  }

  .ev63-button:hover { border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.11); color: white; }
  .ev63-button:active { transform: scale(.98); }
  .ev63-button:disabled { cursor: not-allowed; opacity: .42; }

  .ev63-button--primary {
    border-color: rgba(209,199,255,.4);
    background: linear-gradient(135deg, #f1edff, #b9a7f9);
    box-shadow: 0 .6rem 1.8rem rgba(109,73,217,.24), inset 0 1px white;
    color: #15111f;
  }

  .ev63-button--primary:hover { border-color: white; background: linear-gradient(135deg, white, #c6b7ff); color: #100c18; }

  .ev63-device-card__notice {
    display: flex;
    margin: .7rem 0 0;
    align-items: center;
    gap: .42rem;
    color: rgba(255,255,255,.28);
    font-size: .58rem;
  }

  .ev63-phase {
    position: absolute;
    z-index: 4;
    bottom: 2.6rem;
    left: 50%;
    display: flex;
    width: min(28rem, 36vw);
    align-items: center;
    gap: .8rem;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .ev63-phase span { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.2)); }
  .ev63-phase span:last-child { background: linear-gradient(90deg, rgba(255,255,255,.2), transparent); }
  .ev63-phase p { margin: 0; color: rgba(255,255,255,.35); font-size: .52rem; font-weight: 680; letter-spacing: .15em; white-space: nowrap; }
  [data-phase="materialize"] .ev63-phase p,
  [data-phase="explode"] .ev63-phase p { color: #cbbfff; text-shadow: 0 0 1.4rem rgba(172,145,255,.8); }

  .ev63-view-controls {
    position: absolute;
    z-index: 7;
    top: 7rem;
    right: max(1.25rem, calc((100vw - 78rem) / 2));
    display: grid;
    justify-items: end;
    gap: .6rem;
  }

  .ev63-view-controls > div {
    display: flex;
    gap: .25rem;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: .92rem;
    padding: .25rem;
    background: rgba(8,8,12,.6);
    backdrop-filter: blur(1rem);
  }

  .ev63-view-controls button {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: .38rem;
    border: 0;
    border-radius: .68rem;
    padding: 0 .7rem;
    background: transparent;
    color: rgba(255,255,255,.42);
    font: 620 .65rem/1 inherit;
    cursor: pointer;
  }

  .ev63-view-controls button[aria-pressed="true"] { background: rgba(255,255,255,.11); color: white; box-shadow: inset 0 1px rgba(255,255,255,.09); }
  .ev63-view-controls button:disabled { opacity: .32; cursor: not-allowed; }
  .ev63-view-controls small { color: rgba(255,255,255,.27); font-size: .57rem; }

  .ev63-layer-index {
    position: absolute;
    z-index: 4;
    top: 50%;
    right: max(1.25rem, calc((100vw - 78rem) / 2));
    width: 10.7rem;
    pointer-events: none;
    transform: translateY(-36%);
  }

  .ev63-layer-index ol { display: grid; gap: .1rem; margin: .85rem 0 0; padding: 0; list-style: none; }
  .ev63-layer-index li { display: grid; grid-template-columns: 1.5rem 1fr; align-items: center; min-height: 1.65rem; color: rgba(255,255,255,.26); transition: color 300ms ease, transform 300ms ease; }
  .ev63-layer-index span { font: .52rem/1 ui-monospace, "SFMono-Regular", Consolas, monospace; }
  .ev63-layer-index strong { font-size: .53rem; font-weight: 640; letter-spacing: .08em; }
  [data-phase="explode"] .ev63-layer-index li { color: rgba(231,225,255,.72); transform: translateX(-.35rem); }
  [data-phase="explode"] .ev63-layer-index li:nth-child(2) { transition-delay: 60ms; }
  [data-phase="explode"] .ev63-layer-index li:nth-child(3) { transition-delay: 120ms; }
  [data-phase="explode"] .ev63-layer-index li:nth-child(4) { transition-delay: 180ms; }
  [data-phase="explode"] .ev63-layer-index li:nth-child(5) { transition-delay: 240ms; }
  [data-phase="explode"] .ev63-layer-index li:nth-child(6) { transition-delay: 300ms; }

  .ev63-spec-strip {
    position: absolute;
    z-index: 4;
    right: max(1.25rem, calc((100vw - 78rem) / 2));
    bottom: 2.15rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: .65rem 1.25rem;
    pointer-events: none;
  }

  .ev63-spec-strip div { display: grid; gap: .14rem; min-width: 6rem; }
  .ev63-spec-strip span { color: rgba(255,255,255,.26); font-size: .5rem; font-weight: 650; letter-spacing: .13em; }
  .ev63-spec-strip strong { color: rgba(255,255,255,.62); font: 600 .62rem/1.2 ui-monospace, "SFMono-Regular", Consolas, monospace; }

  .ev63-evidence {
    position: absolute;
    z-index: 5;
    top: calc(max(1rem, env(safe-area-inset-top)) + 4.4rem);
    left: 50%;
    margin: 0;
    color: rgba(255,255,255,.2);
    font-size: .48rem;
    font-weight: 650;
    letter-spacing: .12em;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ev63-evidence a { color: rgba(213,203,255,.45); text-decoration: none; }
  .ev63-evidence a:hover { color: white; }

  .ev63-webgl-fallback {
    position: absolute;
    z-index: 9;
    top: 50%;
    left: 50%;
    width: min(24rem, calc(100% - 2rem));
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 1.25rem;
    padding: 1.5rem;
    background: rgba(12,12,17,.88);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .ev63-webgl-fallback strong { display: block; margin-top: .8rem; }
  .ev63-webgl-fallback p { margin: .5rem 0 0; color: var(--ev63-muted); font-size: .8rem; line-height: 1.6; }

  .ev63-log {
    position: fixed;
    z-index: 80;
