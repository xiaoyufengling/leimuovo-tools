---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowDownRight, ArrowUpRight } from "@lucide/astro";
import { site } from "../config/site";
import "../styles/home.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: site.locale,
  description: site.description,
};
---

<BaseLayout
  title="小鱼｜游戏 UI 与视觉设计"
  description="小鱼的个人设计空间：游戏 UI、视觉设计、动态原型与持续生长的视觉实验室。"
  jsonLd={jsonLd}
>
  <div class="lm-page lm-page--home">
    <div class="home-atmosphere" aria-hidden="true">
      <span class="home-atmosphere__wash home-atmosphere__wash--blue"></span>
      <span class="home-atmosphere__wash home-atmosphere__wash--pearl"></span>
      <span class="home-atmosphere__line"></span>
      <span class="home-atmosphere__grain"></span>
    </div>

    <section class="portfolio-hero lm-container" data-home-hero aria-labelledby="home-title">
      <div class="portfolio-hero__copy" data-home-reveal="0">
        <div class="portfolio-kicker">
          <span>PORTFOLIO / 2026</span>
          <i aria-hidden="true"></i>
          <span>GAME UI & VISUAL DESIGN</span>
        </div>

        <h1 id="home-title">
          <span>Designing</span>
          <em>interfaces</em>
          <strong>with feeling.</strong>
        </h1>

        <p class="portfolio-hero__lede">
          你好，我是小鱼。正在把游戏界面、视觉设计与代码实验，整理成一个不断生长的个人作品空间。
        </p>

        <div class="portfolio-hero__actions">
          <a class="portfolio-button portfolio-button--primary" href="#directions">
            <span>探索设计方向</span>
            <i class="portfolio-button__icon" aria-hidden="true">
              <ArrowDownRight size={18} stroke-width={2.4} />
            </i>
          </a>
          <a class="portfolio-button portfolio-button--quiet" href="/xiaoyugan/">
            <span>进入视觉实验室</span>
            <i class="portfolio-button__icon" aria-hidden="true">
              <ArrowUpRight size={18} stroke-width={2.4} />
            </i>
          </a>
        </div>

        <div class="portfolio-hero__status" aria-label="当前状态">
          <span><i aria-hidden="true"></i> OPEN TO NEW IDEAS</span>
          <span>GAME UI · VISUAL DESIGN · CREATIVE CODING</span>
        </div>
      </div>

      <div class="portfolio-hero__showcase" data-home-reveal="1" data-hero-shift aria-hidden="true">
        <div class="signature-study">
          <span class="signature-study__wash"></span>
          <div class="signature-study__frame">
            <div class="signature-study__chrome">
              <span>PERSONAL ARCHIVE</span>
              <i></i>
              <span>001</span>
            </div>

            <div class="signature-study__field">
              <span class="signature-study__sheet signature-study__sheet--back"></span>
              <span class="signature-study__sheet signature-study__sheet--middle"></span>
              <span class="signature-study__sheet signature-study__sheet--front"></span>
              <span class="signature-study__ribbon"></span>
              <div class="signature-study__type">
                <small>DESIGN / MOTION / CODE</small>
                <strong>MAKE<br />IT FEEL<br /><em>CLEAR.</em></strong>
              </div>
            </div>

            <div class="signature-study__note">
              <span>SELECTED PRACTICE</span>
              <strong>Ideas become<br />interfaces.</strong>
            </div>

            <div class="signature-study__footer">
              <span>GAME UI · VISUAL · MOTION</span>
              <span>LEIMUOVO / 2026</span>
            </div>
          </div>
        </div>
      </div>

      <a class="portfolio-hero__scroll" href="#directions">
        <span>SCROLL TO EXPLORE</span><i aria-hidden="true"></i>
      </a>
    </section>

    <section class="discipline-strip" aria-label="设计方向" data-home-reveal="0">
      <div class="lm-container discipline-strip__inner">
        <span>GAME INTERFACE</span><i aria-hidden="true"></i>
        <span>VISUAL SYSTEM</span><i aria-hidden="true"></i>
        <span>MOTION PROTOTYPE</span><i aria-hidden="true"></i>
        <span>CODEX EXPERIMENT</span>
      </div>
    </section>

    <section class="direction-section lm-container" id="directions" aria-labelledby="directions-title">
      <header class="direction-section__heading" data-home-reveal="0">
        <div>
          <p class="portfolio-eyebrow">SELECTED DIRECTIONS</p>
          <h2 id="directions-title">先展示判断，<br /><span>再慢慢加入作品。</span></h2>
        </div>
        <p>这个空间会持续收录游戏 UI、视觉系统与海报实验。现在先建立一套足够清晰、也足够有辨识度的展示方式。</p>
      </header>

      <div class="direction-grid">
        <article class="direction-card direction-card--game" data-home-reveal="0">
          <div class="direction-card__inner">
            <header><span>01 / PRIMARY FIELD</span><span>GAME UI</span></header>
            <div class="game-canvas" aria-hidden="true">
              <div class="game-canvas__reticle"><span></span><i></i></div>
              <div class="game-canvas__status">
                <span>PLAYER / 01</span>
                <strong>READY</strong>
                <div><i></i><i></i><i></i><i></i></div>
              </div>
              <div class="game-canvas__module">
                <span>ABILITY</span>
                <strong>Q</strong>
                <small>AVAILABLE</small>
              </div>
              <span class="game-canvas__coord">X 084.12 / Y 231.08</span>
            </div>
            <footer>
              <div><p>界面不只是信息。</p><strong>它决定玩家如何感受世界。</strong></div>
              <span>HUD · SYSTEM · MOTION</span>
            </footer>
          </div>
        </article>

        <article class="direction-card direction-card--poster" data-home-reveal="1">
          <div class="direction-card__inner">
            <header><span>02 / NEXT STUDY</span><span>POSTER</span></header>
            <div class="poster-canvas" aria-hidden="true">
              <span class="poster-canvas__edition">EDITION<br />001</span>
              <strong>FORM<br /><i>&</i> CODE</strong>
              <div class="poster-canvas__disc"></div>
              <span class="poster-canvas__note">A STUDY OF TYPE, IMAGE<br />AND GENERATED SYSTEMS.</span>
              <span class="poster-canvas__year">2026</span>
            </div>
            <footer>
              <div><p>下一种表达。</p><strong>海报与 Codex 视觉实验。</strong></div>
              <span>TYPE · IMAGE · CODE</span>
            </footer>
          </div>
        </article>
      </div>
    </section>

    <section class="lab-feature lm-container" aria-labelledby="lab-feature-title" data-home-reveal="0">
      <a class="lab-feature__link" href="/xiaoyugan/" aria-label="进入小鱼干视觉实验室">
        <div class="lab-feature__visual" aria-hidden="true">
          <span class="lab-feature__halo lab-feature__halo--blue"></span>
          <span class="lab-feature__halo lab-feature__halo--pink"></span>
          <div class="lab-glass">
            <span>EXPERIMENT / 001</span>
            <strong>LIQUID<br />GLASS</strong>
            <i></i>
          </div>
          <span class="lab-feature__caption">LIVE MATERIAL · SPATIAL DEPTH · FLUID MOTION</span>
        </div>
        <div class="lab-feature__copy">
          <p class="portfolio-eyebrow">XIAOYUGAN VISUAL LAB</p>
          <h2 id="lab-feature-title">想法先在这里<br /><span>变成可以感受的东西。</span></h2>
          <p>视觉实验室会一直保留。新的材质、动效和交互先在这里发生，成熟以后再回到主界面。</p>
          <div class="lab-feature__action"><span>OPEN LAB 001</span><i aria-hidden="true">↗</i></div>
        </div>
      </a>
    </section>

    <section class="approach-section lm-container" aria-labelledby="approach-title">
      <header data-home-reveal="0">
        <p class="portfolio-eyebrow">HOW I WANT TO WORK</p>
        <h2 id="approach-title">简洁不是减少表达，<br /><span>而是让重点更准确。</span></h2>
      </header>

      <ol class="approach-list">
        <li data-home-reveal="0">
          <span>01</span><div><strong>建立视觉方向</strong><p>先找到作品真正需要的情绪、节奏和识别点。</p></div><small>DIRECTION</small>
        </li>
        <li data-home-reveal="1">
          <span>02</span><div><strong>组织界面系统</strong><p>让信息层级、组件和动效形成同一种语言。</p></div><small>SYSTEM</small>
        </li>
        <li data-home-reveal="2">
          <span>03</span><div><strong>用原型验证感受</strong><p>把静态设计变成可操作、可判断的真实体验。</p></div><small>PROTOTYPE</small>
        </li>
      </ol>
    </section>

    <section class="portfolio-ending lm-container" data-home-reveal="0">
      <div>
        <p class="portfolio-eyebrow">THE ARCHIVE IS OPEN</p>
        <h2>这里会继续长出<br /><span>属于我的作品。</span></h2>
      </div>
      <div class="portfolio-ending__aside">
        <p>游戏 UI、海报、视觉实验和新的个人经历，都会在合适的时候进入这里。</p>
        <a class="portfolio-button portfolio-button--primary" href="/about/">
          <span>认识小鱼</span><i aria-hidden="true">↗</i>
        </a>
      </div>
    </section>
  </div>

  <script is:inline src="/scripts/home.js?v=20260822" defer></script>
</BaseLayout>
