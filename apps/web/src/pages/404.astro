---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatePanel from "../components/StatePanel.astro";
import { site } from "../config/site";
---

<BaseLayout title={`页面不存在｜${site.name}`} description="没有找到你访问的页面。" noindex>
  <div class="lm-page lm-container">
    <section class="lm-state-page">
      <StatePanel
        variant="not-found"
        eyebrow="404"
        title="这里没有找到页面。"
        description="地址可能已经改变，或者这个工具还没有发布。你可以返回工具目录继续浏览。"
        primary={{ href: "/tools/", label: "返回工具目录" }}
        secondary={{ href: "/", label: "返回首页" }}
      />
    </section>
  </div>
</BaseLayout>
