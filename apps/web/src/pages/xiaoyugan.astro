---
import { ArrowLeft, ArrowUpRight, Layers, MousePointer2, PanelsTopLeft, Sparkles } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/xiaoyugan.css";
---

<BaseLayout
  title="小鱼干｜视觉实验室"
  description="小鱼的视觉实验室：界面材质、空间层级、滚动动态与持续生长的个人项目档案。"
  noindex
  hideChrome
>
  <div class="xyg-page" data-xiaoyugan>
    <div class="xyg-ambient" aria-hidden="true">
      <span class="xyg-ambient__plane xyg-ambient__plane--blue"></span>
      <span class="xyg-ambient__plane xyg-ambient__plane--white"></span>
      <span class="xyg-ambient__line"></span>
    </div>

    <header class="xyg-nav xyg-glass">
      <a class="xyg-brand" href="/" aria-label="返回小鱼首页">
        <span class="xyg-brand__mark" aria-hidden="true"></span>
        <span>小鱼干</span>
        <small>VISUAL LAB</small>
      </a>
      <a class="xyg-back" href="/">
        <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
        <span>返回主站</span>
      </a>
    </header>

    <main>
      <section class="xyg-hero" aria-labelledby="xyg-title">
        <div class="xyg-hero__copy" data-reveal>
          <p class="xyg-kicker">VISUAL LAB / INTERFACE STUDIES</p>
          <h1 id="xyg-title">让界面，<br /><span>拥有触感。</span></h1>
          <p class="xyg-hero__lede">游戏 UI、视觉系统、动态原型，以及正在形成的个人作品档案。</p>
          <div class="xyg-hero__meta" aria-label="实验方向">
            <span>GAME UI</span><i></i><span>VISUAL SYSTEM</span><i></i><span>MOTION</span>
          </div>
        </div>

        <div class="xyg-hero__visual" data-hero-visual data-reveal aria-hidden="true">
          <div class="xyg-artboard">
            <span class="xyg-artboard__field"></span>
            <span class="xyg-artboard__slice"></span>
            <span class="xyg-artboard__detail"></span>
            <div class="xyg-artboard__type"><small>FORM / LIGHT</small><strong>Quiet<br />motion.</strong></div>
          </div>

          <div class="xyg-hero__glass-wrap">
            <div class="xyg-hero__glass xyg-glass" data-pointer-glass>
              <div class="xyg-glass-edge" aria-hidden="true"></div>
              <header><span>OPTICAL SURFACE</span><strong>LIVE</strong></header>
              <div class="xyg-hero__glass-body">
                <small>INTERFACE MATERIAL</small>
                <strong>GLASS<br />STUDY</strong>
                <div class="xyg-meter"><span></span><i></i></div>
                <footer><span>DEPTH</span><span>REFRACTION</span><span>RESPONSE</span></footer>
              </div>
            </div>
          </div>

          <div class="xyg-hero__chip xyg-glass"><MousePointer2 size={15} aria-hidden="true" /><span>RESPONSIVE MATERIAL</span></div>
        </div>

        <a class="xyg-scroll" href="#material"><span>向下进入实验</span><i aria-hidden="true"></i></a>
      </section>

      <section class="xyg-material" id="material" aria-labelledby="material-title" data-material>
        <div class="xyg-material__sticky">
          <div class="xyg-material__copy">
            <p class="xyg-kicker">01 / MATERIAL IN MOTION</p>
            <h2 id="material-title">玻璃浮在内容上，<br /><span>而不是盖住内容。</span></h2>
            <div class="xyg-material__steps" aria-live="polite">
              <article class="xyg-material-step is-first">
                <small>LIGHT</small><strong>光线定义边缘</strong><p>亮边、阴影和背景共同说明材质的位置。</p>
              </article>
              <article class="xyg-material-step">
                <small>DEPTH</small><strong>层级跟随滚动</strong><p>内容继续移动，控制层保持轻盈和清晰。</p>
              </article>
              <article class="xyg-material-step">
                <small>RESPONSE</small><strong>动态来自操作</strong><p>材质只在交互发生时回应，不做无意义的循环表演。</p>
              </article>
            </div>
          </div>

          <div class="xyg-material__visual" aria-hidden="true">
            <div class="xyg-content-scene">
              <div class="xyg-content-scene__panel xyg-content-scene__panel--primary"><span>GAME / INTERFACE</span><strong>CONTENT<br />FIRST</strong></div>
              <div class="xyg-content-scene__panel xyg-content-scene__panel--secondary"><span>VISUAL / 001</span></div>
              <div class="xyg-content-scene__panel xyg-content-scene__panel--detail"></div>
            </div>
            <div class="xyg-material-glass xyg-glass" data-material-glass>
              <div class="xyg-glass-edge" aria-hidden="true"></div>
              <header><span>FLOATING CONTROL</span><strong>ACTIVE</strong></header>
              <div><Layers size={20} aria-hidden="true" /><strong>Spatial layer</strong><small>CONTENT REMAINS CLEAR</small></div>
              <footer><span>01</span><i></i><span>03</span></footer>
            </div>
          </div>
        </div>
      </section>

      <section class="xyg-archive" id="archive" aria-labelledby="archive-title">
        <header class="xyg-section-heading" data-reveal>
          <div>
            <p class="xyg-kicker">02 / PROJECT ARCHIVE</p>
            <h2 id="archive-title">把实验，<br /><span>慢慢变成作品。</span></h2>
          </div>
          <p>这里为游戏 UI、海报、视觉系统和以后真正完成的个人项目保留位置。</p>
        </header>

        <div class="xyg-project-grid">
          <article class="xyg-project xyg-project--game" data-reveal>
            <header><span>PRIMARY FIELD</span><strong>GAME UI</strong></header>
            <div class="xyg-project__screen" aria-hidden="true">
              <div class="xyg-project__nav"><span>OVERVIEW</span><span class="is-active">LOADOUT</span><span>ARCHIVE</span></div>
              <div class="xyg-project__module"><small>INTERFACE SYSTEM</small><strong>READY</strong><span></span></div>
              <p>PLAYER / 01<br />STATUS ONLINE</p>
            </div>
            <footer><div><small>CURRENT DIRECTION</small><strong>游戏界面与交互系统</strong></div><span>UI / MOTION / FEEDBACK</span></footer>
          </article>

          <article class="xyg-project xyg-project--next" data-reveal>
            <header><span>NEXT FIELD</span><strong>POSTER / VISUAL</strong></header>
            <div class="xyg-project__poster" aria-hidden="true">
              <small>TYPE · IMAGE · CODE</small>
              <strong>FORM<br />IN<br />MOTION</strong>
              <span></span>
            </div>
            <footer><div><small>OPEN SLOT</small><strong>海报与个人视觉项目</strong></div><span>COMING NEXT</span></footer>
          </article>
        </div>

        <article class="xyg-open-slot" data-reveal>
          <div><PanelsTopLeft size={20} stroke-width={1.7} aria-hidden="true" /><span>THE ARCHIVE IS OPEN</span></div>
          <h3>以后做过的项目，<br /><span>都可以继续放进来。</span></h3>
          <p>实验室保留探索过程，成熟内容再进入主站的个人作品集。</p>
        </article>
      </section>

      <section class="xyg-finale" aria-labelledby="finale-title" data-reveal>
        <div class="xyg-finale__surface" aria-hidden="true">
          <span></span><span></span><span></span>
          <div class="xyg-finale__glass xyg-glass"><Sparkles size={20} aria-hidden="true" /><strong>STAY CURIOUS</strong></div>
        </div>
        <div class="xyg-finale__content">
          <p class="xyg-kicker">XIAOYUGAN / CONTINUE</p>
          <h2 id="finale-title">保持简单，<br /><span>继续实验。</span></h2>
          <p>新的材质、动态和作品，会继续在这里出现。</p>
          <a class="xyg-glass" href="/">回到小鱼的个人网站 <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const page = document.querySelector<HTMLElement>("[data-xiaoyugan]");
  if (page) {
    gsap.registerPlugin(ScrollTrigger);

    const revealItems = gsap.utils.toArray<HTMLElement>("[data-reveal]", page);
    const heroRevealItems = gsap.utils.toArray<HTMLElement>(".xyg-hero [data-reveal]", page);
    const sectionRevealItems = revealItems.filter((item) => !item.closest(".xyg-hero"));
    const media = gsap.matchMedia();

    media.add({
      desktop: "(min-width: 992px)",
      reduceMotion: "(prefers-reduced-motion: reduce)",
    }, (context) => {
      const { desktop, reduceMotion } = context.conditions as { desktop: boolean; reduceMotion: boolean };

      if (reduceMotion) {
        gsap.set(revealItems, { autoAlpha: 1, y: 0 });
        return;
      }

      gsap.fromTo(heroRevealItems,
        { autoAlpha: 0, y: 24 },
        { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1, ease: "power2.out" },
      );

      gsap.set(sectionRevealItems, { autoAlpha: 0, y: 28 });
      ScrollTrigger.batch(sectionRevealItems, {
        start: "top 88%",
        once: true,
        onEnter: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.75, stagger: 0.08, ease: "power2.out", overwrite: true }),
      });

      gsap.to(".xyg-hero__glass-wrap", {
        y: -34,
        rotation: 1.6,
        ease: "none",
        scrollTrigger: { trigger: ".xyg-hero", start: "top top", end: "bottom top", scrub: 0.8 },
      });

      if (desktop) {
        const steps = gsap.utils.toArray<HTMLElement>(".xyg-material-step", page);
        const [lightStep, depthStep, responseStep] = steps;
        if (!lightStep || !depthStep || !responseStep) return;
        gsap.set(steps, { autoAlpha: 0, y: 16 });
        gsap.set(lightStep, { autoAlpha: 1, y: 0 });

        const materialTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: ".xyg-material",
            start: "top top",
            end: "bottom bottom",
            scrub: 1,
          },
        });

        materialTimeline
          .to(".xyg-material-glass", { y: -34, rotation: -1.5, scale: 1.035, ease: "none" }, 0)
          .to(".xyg-content-scene__panel--primary", { x: -26, y: 12, ease: "none" }, 0)
          .to(lightStep, { autoAlpha: 0, y: -12, duration: 0.12 }, 0.24)
          .to(depthStep, { autoAlpha: 1, y: 0, duration: 0.12 }, 0.3)
          .to(".xyg-material-glass", { y: 28, rotation: 1.2, scale: 0.97, ease: "none" }, 0.45)
          .to(".xyg-content-scene__panel--secondary", { x: 34, y: -18, ease: "none" }, 0.45)
          .to(depthStep, { autoAlpha: 0, y: -12, duration: 0.12 }, 0.68)
          .to(responseStep, { autoAlpha: 1, y: 0, duration: 0.12 }, 0.74);
      }
    });

    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const pointerGlass = page.querySelector<HTMLElement>("[data-pointer-glass]");
      const visual = page.querySelector<HTMLElement>("[data-hero-visual]");
      if (pointerGlass && visual) {
        const xTo = gsap.quickTo(pointerGlass, "x", { duration: 0.4, ease: "power3.out" });
        const yTo = gsap.quickTo(pointerGlass, "y", { duration: 0.4, ease: "power3.out" });
        const rotateXTo = gsap.quickTo(pointerGlass, "rotationX", { duration: 0.4, ease: "power3.out" });
        const rotateYTo = gsap.quickTo(pointerGlass, "rotationY", { duration: 0.4, ease: "power3.out" });

        visual.addEventListener("pointermove", (event) => {
          const rect = visual.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          xTo(x * 10);
          yTo(y * 8);
          rotateXTo(y * -3);
          rotateYTo(x * 4);
        }, { passive: true });

        visual.addEventListener("pointerleave", () => {
          xTo(0); yTo(0); rotateXTo(0); rotateYTo(0);
        });
      }
    }

    window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
  }
</script>
