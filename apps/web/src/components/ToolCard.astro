---
import { ArrowUpRight, FileSpreadsheet, LockKeyhole } from "@lucide/astro";
import type { listTools } from "../modules/tool-catalog";

interface Props {
  tool: ReturnType<typeof listTools>[number];
}

const { tool } = Astro.props;
---

<a class="tool-card lm-card lm-card--interactive lm-motion-enter" href={tool.href}>
  <div class="tool-card__icon" aria-hidden="true">
    <FileSpreadsheet size={23} stroke-width={1.75} />
  </div>
  <div class="tool-card__content">
    <div class="tool-card__heading">
      <h2>{tool.copy.title}</h2>
      <ArrowUpRight size={18} stroke-width={1.75} aria-hidden="true" />
    </div>
    <p>{tool.copy.summary}</p>
    <div class="tool-card__meta">
      <span>{tool.category}</span>
      {tool.processing === "local" && <span><LockKeyhole size={14} stroke-width={1.75} aria-hidden="true" />本机处理</span>}
    </div>
  </div>
</a>
