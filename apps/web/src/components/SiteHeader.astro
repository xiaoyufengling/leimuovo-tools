---
import { Moon, Sparkles, Sun } from "@lucide/astro";
import BrandMark from "./BrandMark.astro";
import RemCatEars from "./RemCatEars.astro";
import { site } from "../config/site";

const pathname = Astro.url.pathname;
const isTools = pathname.startsWith("/tools");
const isAbout = pathname.startsWith("/about");
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
  <div class="lm-container site-header__inner">
    <div class="brand-cluster">
      <RemCatEars label="摸摸小鱼名字上的猫耳" />
      <a class="brand-link" href="/" aria-label={`${site.name}首页`}>
        <BrandMark size={30} />
        <span class="brand-name">{site.name}</span>
      </a>
    </div>
    <nav class="site-nav" aria-label="主导航">
      <a href="/about/" aria-current={isAbout ? "page" : undefined}>关于</a>
      <a href="/tools/" aria-current={isTools ? "page" : undefined}>工具</a>
      <button class="lm-icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换外观" title="切换外观">
        <Moon class="theme-icon theme-icon--moon" size={19} stroke-width={1.75} aria-hidden="true" />
        <Sun class="theme-icon theme-icon--sun" size={19} stroke-width={1.75} aria-hidden="true" />
      </button>
      <a class="site-lab-link" href="/xiaoyugan/" aria-label="进入小鱼干视觉实验室">
        <Sparkles size={15} stroke-width={1.8} aria-hidden="true" />
        <span>实验室</span>
      </a>
    </nav>
  </div>
</header>
