---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/playground.css";
import { site } from "../config/site";
const jsonLd = { "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.url, inLanguage: site.locale, description: "小鱼的视觉游乐场。探索光、形状与触感。" };
---
<BaseLayout title="小鱼 LEIMUOVO｜Visual Playground" description="光、形状，以及一点好奇心。小鱼的视觉游乐场。" jsonLd={jsonLd} hideChrome>
  <div class="playground" data-playground>
    <a class="pg-skip" href="#flow">跳到交互内容</a>
    <header class="pg-header">
      <a class="pg-logo" href="/" aria-label="小鱼首页"><span class="pg-symbol" aria-hidden="true"></span>LEIMUOVO<span class="pg-logo-dot">®</span></a>
      <nav class="pg-nav site-nav" aria-label="主导航"><a class="pg-nav-active" href="#experiments">实验</a><a href="/tools/">工具</a><a href="/about/">关于</a></nav>
      <button class="pg-motion" type="button" aria-pressed="false" data-motion-toggle><span class="pg-motion-icon" aria-hidden="true">Ⅱ</span><span data-motion-label>暂停动效</span></button>
    </header>

    <section class="pg-hero" id="experiments" aria-labelledby="pg-title">
      <div class="pg-orbit-label" aria-hidden="true">VISUAL PLAYGROUND<br/>VOL. 01 / 2026</div>
      <div class="pg-hero-copy"><p class="pg-eyebrow"><span></span>光、形状，以及一点好奇心</p><h1 id="pg-title">BEYOND<br/><i>the</i> SURFACE<span class="pg-title-period">.</span></h1><p class="pg-hero-note">让感觉，自由成形。</p></div>
      <div class="pg-hero-bottom">
        <a class="pg-scroll-link" href="#flow"><span class="pg-scroll-mark" aria-hidden="true"></span><span>向下，继续感受<small>SCROLL TO DISCOVER</small></span></a>
        <span class="pg-hero-index">01 / LIGHT FIELD</span>
      </div>
    </section>

    <section class="pg-flow" id="flow" aria-labelledby="flow-title">
      <div class="pg-section-top"><span>01 / FIELD NOTES</span><span>MOVE · TOUCH · FEEL</span></div>
      <div class="pg-flow-heading"><p class="pg-eyebrow">每一次经过，都留下波纹</p><h2 id="flow-title">Go with<br/><i>the flow.</i></h2></div>
      <canvas data-flow-canvas class="pg-flow-canvas" aria-label="响应指针或触摸位置的光线场" role="img"></canvas>
      <div class="pg-flow-footer"><p>移动指针，扰动这片光。<span>手机上，轻点任意位置。</span></p><div class="pg-segmented" aria-label="光场形态"><button type="button" data-field="0" aria-pressed="true">流线</button><button type="button" data-field="1" aria-pressed="false">涟漪</button><button type="button" data-field="2" aria-pressed="false">轨道</button></div></div>
      <div class="pg-field-coordinate" aria-hidden="true">X <span data-coordinate-x>0.50</span><br/>Y <span data-coordinate-y>0.50</span></div>
    </section>

    <section class="pg-space" id="space" aria-labelledby="space-title">
      <div class="pg-section-top"><span>02 / SPATIAL STUDY</span><span>A LITTLE ROOM TO PLAY</span></div>
      <div class="pg-space-copy"><p class="pg-eyebrow">在平面之外</p><h2 id="space-title">留一点<br/><i>想象的空间。</i></h2><p class="pg-space-description">从一片，到一整个维度。<br/>试着拉开它。</p></div>
      <div class="pg-glass-stage" data-glass-stage aria-label="可控制展开程度的三层玻璃平面" role="img">
        <div class="pg-glass-shadow"></div><div class="pg-glass-stack" data-glass-stack>
          <div class="pg-glass-plane pg-glass-plane-back"><span>03</span><b>FEEL</b><small>LIGHT / DEPTH / SPACE</small></div>
          <div class="pg-glass-plane pg-glass-plane-middle"><span>02</span><b>PLAY</b><small>LIGHT / DEPTH / SPACE</small></div>
          <div class="pg-glass-plane pg-glass-plane-front"><span>01</span><b>FORM</b><small>LIGHT / DEPTH / SPACE</small><i class="pg-plane-cross"></i></div>
        </div>
      </div>
      <div class="pg-space-controls"><button type="button" data-space-preset="0" aria-label="合拢玻璃平面">合拢</button><label for="space-control" class="pg-space-range"><span>展开程度 <output id="space-value">55%</output></span><input id="space-control" data-space-control type="range" min="0" max="100" value="55" /></label><button type="button" data-space-preset="100" aria-label="展开玻璃平面">展开</button></div>
    </section>

    <footer class="pg-footer"><div class="pg-footer-top"><span>STAY CURIOUS.</span><a href="#experiments">回到开头 <span aria-hidden="true">↟</span></a></div><div class="pg-footer-bottom"><a class="pg-logo" href="/">LEIMUOVO<span class="pg-logo-dot">®</span></a><span>一个持续生长的视觉游乐场</span><div><a href="/tools/">工具箱</a><a href="/about/">关于小鱼</a><a href="/privacy/" data-control-gesture>隐私</a></div><span>© 2026</span></div></footer>
    <noscript><p class="pg-noscript">当前显示静态版本。开启 JavaScript 后，可调整材质、光场与空间。</p></noscript>
  </div>
  <script>
    // Keep this bootstrap external: the production CSP intentionally forbids inline scripts.
    import("../scripts/playground");
  </script>
</BaseLayout>
