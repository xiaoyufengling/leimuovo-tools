{
  "name": "@leimuovo/control-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --project tsconfig.json",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:deploy": "pnpm verify:assets && wrangler deploy --dry-run --outdir dist/worker-bundle"
  },
  "dependencies": {
    "@leimuovo/control-core": "workspace:*",
    "@leimuovo/design-system": "workspace:*",
    "jose": "^6.2.8",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
